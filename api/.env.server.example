# Divergram API server env
PORT=

# CORS
CORS_ORIGINS=

# DB
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# Security
JWT_SECRET=
ADMIN_API_KEY=
# 32 random bytes encoded as base64 or 64 hexadecimal characters.
DATA_ENCRYPTION_KEY=

# Upload storage
UPLOAD_DIR=
UPLOAD_BASE_URL=
MAX_UPLOAD_MB=

# OAuth
OAUTH_CALLBACK_BASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://api.divergram.com/api/auth/oauth/threads/callback

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://api.divergram.com/api/auth/oauth/instagram/mobile/callback
INSTAGRAM_APP_RETURN_URI=divergram://auth/instagram
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic

# Apple Wallet diving license pass signing
APPLE_WALLET_PASS_TYPE_ID=pass.com.divergram.app.ios.license
APPLE_WALLET_TEAM_ID=6G5RCDLQLG
APPLE_WALLET_WWDR_CERT_PATH=/home/divergram/private/apple-wallet/AppleWWDRCAG4.pem
APPLE_WALLET_SIGNER_CERT_PATH=/home/divergram/private/apple-wallet/pass-cert.pem
APPLE_WALLET_SIGNER_KEY_PATH=/home/divergram/private/apple-wallet/pass-key.pem
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=

# Google Wallet generic pass signing. The service account must be authorized
# in the Google Wallet issuer account.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
GOOGLE_WALLET_SERVICE_ACCOUNT_PATH=/home/divergram/private/google-wallet/service-account.json

# Server-side AI only. Mobile clients must never receive this API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_DIVE_SUMMARY_MODEL=gpt-4.1-mini
OPENAI_DIVE_CAPTION_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# SMTP (Gmail App Password)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WEB_APP_BASE_URL=

# SMS verification webhook. It receives JSON with phone, code, message, and userId.
SMS_VERIFY_WEBHOOK_URL=
SMS_VERIFY_WEBHOOK_TOKEN=

# Infobip HTTP APIs. When configured, these take priority over SMTP/SMS webhook.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SMS_SENDER=
INFOBIP_EMAIL_SENDER=
INFOBIP_BILLING_CALLBACK_TOKEN=
PUBLIC_API_BASE_URL=https://api.divergram.com

# Resort booking payments. Keep disabled until a PCI-compliant gateway adapter
# has been approved and its sandbox webhook has passed end-to-end verification.
RESORT_PAYMENT_ENABLED=false
RESORT_PAYMENT_PROVIDER=disabled
RESORT_PAYMENT_GATEWAY_URL=
RESORT_PAYMENT_GATEWAY_TOKEN=
RESORT_PAYMENT_WEBHOOK_SECRET=
# Airwallex HPP. Use sample without API credentials, demo for sandbox credentials,
# and production only after account approval and webhook verification.
AIRWALLEX_ENVIRONMENT=sample
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_CHECKOUT_SECRET=
APPLE_PAY_MERCHANT_ID=merchant.com.divergram.app
APPLE_PAY_COUNTRY_CODE=US
APPLE_PAY_SUPPORTED_NETWORKS=visa,masterCard,amex
GOOGLE_PAY_ENVIRONMENT=TEST
GOOGLE_PAY_MERCHANT_NAME=Divergram
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_COUNTRY_CODE=US
GOOGLE_PAY_SUPPORTED_NETWORKS=VISA,MASTERCARD,AMEX,JCB
# Values are issued by the selected Google Pay-supported payment gateway.
GOOGLE_PAY_GATEWAY=
GOOGLE_PAY_GATEWAY_MERCHANT_ID=

# PayPal Checkout for physical resort booking deposits only.
# Use sandbox until the full booking, webhook, refund, and accounting flow is verified.
# RESORT_PAYMENT_PROVIDER=paypal
# RESORT_PAYMENT_ENABLED=true
PAYPAL_ENVIRONMENT=sandbox
# Sandbox and Live credentials are kept separately. The admin environment
# switch selects one set without ever sending secrets to the browser.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=
# Legacy single-environment fallback (prefer the environment-specific values).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# A separate random value is recommended. JWT_SECRET is used only as a fallback.
PAYPAL_CHECKOUT_SECRET=

# Annual AI membership. Create matching auto-renewable subscription products
# in App Store Connect and Google Play Console before enabling either platform.
APPLE_IAP_ANNUAL_PRODUCT_ID=com.divergram.app.annual_ai.yearly
APPLE_IAP_BUNDLE_ID=com.divergram.app.ios
APPLE_IAP_APP_ID=6769253236
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY_PATH=/home/divergram/private/apple-iap/SubscriptionKey.p8
GOOGLE_PLAY_ANNUAL_PRODUCT_ID=annual_ai_yearly
GOOGLE_PLAY_PACKAGE_NAME=com.divergram.app
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=/home/divergram/private/google-play/service-account.json

# Push notifications (Firebase Cloud Messaging)
# Either paste the service account JSON or point to a file path.
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=

# Topic used for broadcast pushes
FCM_ALL_USERS_TOPIC=all_users

# API health monitor (installed as a systemd timer on production)
DIVERGRAM_ALERT_EMAIL=
DIVERGRAM_NODE_BINARY=node
DIVERGRAM_EMAIL_ALERT_SCRIPT=/home/divergram/api/scripts/send-health-alert.mjs
